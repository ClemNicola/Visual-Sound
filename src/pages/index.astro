---
import { DATA_SONGS } from "../constants/song";
import { params } from "../constants/params";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preload" href="/fonts/JetBrainsMono-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="preload" href="/fonts/Unbounded-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Visual Sound</title>
	</head>
	<body>
		<nav>
			<p>Visual Sound</p>		
			<div class="nav-experience">
				<p>Visual Experience</p>
				<div id="songs-info">
					<p id="song-title">title: {DATA_SONGS[0].title}</p>
					<p id="song-artist">artist: {DATA_SONGS[0].artist}</p>
					<p id="song-album">album: {DATA_SONGS[0].album}</p>
				</div>
			</div>
			
		</nav>
		<div id="sketch"></div>
		<footer>
			<div class="effects-panel">
				<div class="param-container">
					<label for="sphere">Sphere</label>
					<input id="sphere" data-param="sphere" type="checkbox" checked={params.sphere} />
				</div>
				<div class="param-container">
					<label for="ampSmoothing">Amplitude Smoothing</label>
					<input id="ampSmoothing" data-param="ampSmoothing" type="range" min="0.0001" max="1" step="0.001" value={params.ampSmoothing} />
				</div>
				<div class="param-container">
					<label for="top">Top</label>
					<input id="top" data-param="top" type="range" min="10" max="600" step="10" value={params.top} />
				</div>
				<div class="param-container">
					<label for="radius">Radius</label>
					<input id="radius" data-param="radius" type="range" min="4" max="24" step="1" value={params.radius} />
				</div>
				<p>Modify Effects </p>
			</div>
			<p>By Clement Nicolas</p>
		</footer>
		<canvas id="carousel3d"></canvas>
		
	</body>
</html>



<script>
	// import { sketch } from "../sketches/main";
	import { Carousel3D } from "../sketches/carousel";
	import { WebGLSketch } from "../sketches/webglTest";
	import { params, type Params } from "../constants/params";
	import p5 from "p5";

	(window as any).p5 = p5;
	await import("p5/lib/addons/p5.sound");
	if (document.readyState !== "complete") {
		await new Promise((resolve) => window.addEventListener("load", resolve, { once: true }));
	}

	document.querySelectorAll<HTMLInputElement>("[data-param]").forEach((input) => {
		input.addEventListener("input", () => {
			const key = input.dataset.param as keyof Params;
			const value = input.type === "checkbox" ? input.checked : input.valueAsNumber;
			(params as Record<string, number | boolean>) [key] = value;
		});
	})

	let selectTrack = (_index: number) => {}

	new p5((p) => selectTrack = WebGLSketch(p), document.getElementById("sketch") as HTMLElement);
	Carousel3D(selectTrack);
</script>

<style is:global>

@font-face {
  font-family: "Unbounded";
  src: url("/fonts/Unbounded-VariableFont_wght.ttf") format("truetype");
  font-weight: 200 900;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "JetBrainsMono";
  src: url("/fonts/JetBrainsMono-VariableFont_wght.ttf") format("truetype");
  font-weight: 200 900;
  font-style: normal;
  font-display: swap;
}
	html, body {
	  margin: 0;
	  padding: 0;
	  background: #e3e3db;
	  box-sizing: border-box;
	}
	#sketch,
	#sketch canvas {
	  display: block;
	  width: 100vw;
  	  height: 100vh;
	}

	nav, footer {
		position: fixed;
		left: 0;
		right: 0;
		box-sizing: border-box;
		padding: 2em;
		display: flex;
		justify-content: space-between;
		align-items: center;
		z-index: 2	;
	}
	p {
		font-family: "Unbounded", sans-serif;
		font-weight: 400;
		font-size: 1rem;
		mix-blend-mode: difference;
	}

	nav {
		top: 0;
	}
	footer {
		bottom: 0;
		/* aligne "By Clement Nicolas" sur la dernière ligne ("Modify Effects") */
		align-items: flex-end;
		pointer-events: auto;
	}
	footer p {
		margin: 0;
	}

	#carousel3d {
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100vw;
		height: 20vh;
		overflow: hidden;
		z-index: 1;
		cursor: pointer;
	}

	nav {
  align-items: flex-start;
}

.nav-experience,
#songs-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

#songs-info p {
  margin: 0;
  font-family: "JetBrainsMono", monospace;
}


.effects-panel {
	--ink: #111;
	display: flex;
	flex-direction: column;
	gap: 14px;
}

.param-container {
	font-family: "JetBrainsMono", monospace;
	font-size: 0.7rem;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: var(--ink);
	display: flex;
	flex-direction: column;
	gap: 6px;
	width: 180px;
}
.param-container label {
	cursor: pointer;
}
/* checkbox : label à gauche, case à droite sur la même ligne */
.param-container:has(input[type="checkbox"]) {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
}

.param-container input[type="range"] {
	-webkit-appearance: none;
	appearance: none;
	width: 100%;
	height: 14px;
	margin: 0;
	background: transparent;
	cursor: pointer;
}
.param-container input[type="range"]::-webkit-slider-runnable-track {
	height: 1px;
	background: var(--ink);
}
.param-container input[type="range"]::-webkit-slider-thumb {
	-webkit-appearance: none;
	width: 10px;
	height: 10px;
	margin-top: -4.5px;
	background: var(--ink);
	border: none;
	border-radius: 0;
}
.param-container input[type="range"]::-moz-range-track {
	height: 1px;
	background: var(--ink);
}
.param-container input[type="range"]::-moz-range-thumb {
	width: 10px;
	height: 10px;
	background: var(--ink);
	border: none;
	border-radius: 0;
}

.param-container input[type="checkbox"] {
	-webkit-appearance: none;
	appearance: none;
	width: 12px;
	height: 12px;
	margin: 0;
	border: 1px solid var(--ink);
	background: transparent;
	cursor: pointer;
	display: grid;
	place-content: center;
}
.param-container input[type="checkbox"]::before {
	content: "";
	width: 6px;
	height: 6px;
	background: var(--ink);
	transform: scale(0);
	transition: transform 0.12s ease;
}
.param-container input[type="checkbox"]:checked::before {
	transform: scale(1);
}

.param-container input:focus-visible {
	outline: 1px dashed var(--ink);
	outline-offset: 3px;
}
  </style>
